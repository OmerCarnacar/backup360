<ui:FluentWindow x:Class="Backup360.UI.TargetEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Yeni hedef tanımla" Width="660" Height="760" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar Title="Yeni hedef tanımla" ShowMaximize="False" ShowMinimize="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Fields" Margin="24,4,24,12">
                <TextBlock Text="Hedef adı (örn: sirket-drive)" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                <ui:TextBox x:Name="NameBox" />
                <TextBlock Text="Tür" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="TypeBox" SelectionChanged="Type_Changed" />
                <TextBlock Text="Giriş yöntemi" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="AuthBox" SelectionChanged="Auth_Changed" />

                <ui:InfoBar x:Name="Hint" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,14,0,0" />
                <WrapPanel x:Name="Links" Margin="0,10,0,0" />
                <TextBlock x:Name="ClientStatus" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <StackPanel x:Name="customClient"><CheckBox x:Name="UseOwnClient" Content="Gelişmiş: kendi Google Client ID'mi kullanacağım" Margin="0,12,0,0" Checked="Own_Changed" Unchecked="Own_Changed" /></StackPanel>
                <StackPanel x:Name="clientId"><TextBlock x:Name="ClientIdLabel" Text="Client ID" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="ClientId" /></StackPanel>
                <StackPanel x:Name="clientSecret"><TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" /><ui:PasswordBox x:Name="ClientSecret" /></StackPanel>
                <StackPanel x:Name="fullDrive"><CheckBox x:Name="FullDrive" Margin="0,12,0,0"><TextBlock Text="Drive'daki tüm dosyalara eriş (Bulut Gezgini için). Kapalıysa yalnızca Backup360'ın yüklediği dosyalar görünür." TextWrapping="Wrap" /></CheckBox></StackPanel>
                <StackPanel x:Name="token">
                    <TextBlock Text="Token" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="Token" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                    <StackPanel x:Name="tokenRow" Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button x:Name="TokenButton" Content="Token al" Icon="{ui:SymbolIcon Key24}" Appearance="Primary" Click="GetToken_Click" />
                        <TextBlock x:Name="TokenStatus" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="host"><TextBlock Text="Sunucu" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Host" /></StackPanel>
                <StackPanel x:Name="port"><TextBlock Text="Port (0 = varsayılan)" Style="{StaticResource FieldLabel}" /><ui:NumberBox x:Name="Port" Minimum="0" Maximum="65535" Value="0" Width="180" HorizontalAlignment="Left" /></StackPanel>
                <StackPanel x:Name="url"><TextBlock Text="Adres (https://...)" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Url" /></StackPanel>
                <StackPanel x:Name="path">
                    <TextBlock x:Name="PathLabel" Text="Klasör" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="PathBox" />
                        <ui:Button x:Name="PickButton" Grid.Column="1" Content="Seç" Icon="{ui:SymbolIcon Folder24}" Margin="8,0,0,0" Click="Pick_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="user"><TextBlock Text="Kullanıcı" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="User" /></StackPanel>
                <StackPanel x:Name="password"><TextBlock Text="Şifre" Style="{StaticResource FieldLabel}" /><ui:PasswordBox x:Name="PasswordBox" /></StackPanel>
                <StackPanel x:Name="tls"><CheckBox x:Name="Tls" Content="TLS kullan (FTPS)" Margin="0,12,0,0" /></StackPanel>
                <StackPanel x:Name="access"><TextBlock Text="Access Key" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Access" /></StackPanel>
                <StackPanel x:Name="secret"><TextBlock Text="Secret Key" Style="{StaticResource FieldLabel}" /><ui:PasswordBox x:Name="Secret" /></StackPanel>
                <StackPanel x:Name="endpoint"><TextBlock Text="Endpoint (AWS dışı sağlayıcılar için)" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Endpoint" /></StackPanel>
                <StackPanel x:Name="region"><TextBlock Text="Bölge" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Region" /></StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
            <ui:Button Content="Vazgeç" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
            <ui:Button x:Name="SaveButton" Content="Kaydet" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" MinWidth="120" Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
