<Page x:Class="Backup360.UI.ProblemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Resources>
        <Style x:Key="GridLines" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="RowHeight" Value="34" />
        </Style>
        <DataTemplate x:Key="LevelCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" />
                <TextBlock Text="{Binding Level}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <StackPanel Margin="24,8,24,16">
        <Grid Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Sorunlar" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Hatalar, uyarılar, yedeklenemeyen dosyalar ve buluta aktarılamayan öğeler. Aynı öğe sonradan başarıyla tamamlanınca kaydı kendiliğinden kapanır." Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <UniformGrid Columns="4" Margin="0,0,0,10">
            <ui:Card Margin="0,0,6,0" Padding="14,10"><StackPanel><TextBlock Text="Açık hata" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="OpenErrors" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
            <ui:Card Margin="6,0" Padding="14,10"><StackPanel><TextBlock Text="Açık uyarı" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="OpenWarnings" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
            <ui:Card Margin="6,0" Padding="14,10"><StackPanel><TextBlock Text="Bugün" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="TodayCount" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
            <ui:Card Margin="6,0,0,0" Padding="14,10"><StackPanel><TextBlock Text="Son 7 gün" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="WeekCount" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
        </UniformGrid>

        <TextBlock Text="Yedeklenemeyen veya aktarılamayan öğeler" Style="{StaticResource Section}" Margin="0,4,0,6" />
        <ui:Card Padding="4">
            <Grid>
                <DataGrid x:Name="OpenGrid" Style="{StaticResource GridLines}" SelectionMode="Extended" MinHeight="110" MaxHeight="260" SelectionChanged="Open_Changed" MouseDoubleClick="Open_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Son görülme" Binding="{Binding When}" Width="125" />
                        <DataGridTemplateColumn Header="Tür" Width="85" CellTemplate="{StaticResource LevelCell}" />
                        <DataGridTextColumn Header="İş" Binding="{Binding Job}" Width="150" />
                        <DataGridTextColumn Header="Öğe" Binding="{Binding Item}" Width="260" />
                        <DataGridTextColumn Header="Kaç kez" Binding="{Binding Count}" Width="70" />
                        <DataGridTextColumn Header="Son ileti" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="OpenEmpty" Text="Açık sorun yok. Tüm öğeler yedeklendi ve aktarıldı." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </ui:Card>
        <ui:InfoBar x:Name="AdviceBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button x:Name="GoButton" Content="Çözüme git" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary" Margin="0,0,8,0" Click="Go_Click" />
            <ui:Button x:Name="RetryButton" Content="İşi yeniden çalıştır" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0" Click="Retry_Click" />
            <ui:Button Content="Seçilenleri çözüldü işaretle" Icon="{ui:SymbolIcon Checkmark24}" Margin="0,0,8,0" Click="ResolveSelected_Click" />
            <ui:Button Content="Tümünü çözüldü işaretle" Icon="{ui:SymbolIcon CheckmarkCircle24}" Margin="0,0,8,0" Click="ResolveAll_Click" />
            <ui:Button Content="Yenile" Icon="{ui:SymbolIcon ArrowSync24}" Click="Refresh_Click" />
        </StackPanel>

        <Grid Margin="0,14,0,6">
            <TextBlock Text="Günlük kayıt" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="OnlyOpen" Content="Yalnızca çözülmeyenler" Margin="0,0,14,0" Click="Filter_Click" />
                <ComboBox x:Name="Period" Width="150" SelectionChanged="Period_Changed">
                    <ComboBoxItem Content="Bugün" />
                    <ComboBoxItem Content="Son 7 gün" />
                    <ComboBoxItem Content="Son 30 gün" />
                    <ComboBoxItem Content="Tümü" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <ui:Card Padding="4">
            <Grid>
                <DataGrid x:Name="LogGrid" Style="{StaticResource GridLines}" SelectionMode="Single" MinHeight="140" MaxHeight="420">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Gün" Binding="{Binding Day}" Width="115" />
                        <DataGridTextColumn Header="Saat" Binding="{Binding Clock}" Width="70" />
                        <DataGridTemplateColumn Header="Tür" Width="85" CellTemplate="{StaticResource LevelCell}" />
                        <DataGridTextColumn Header="İş" Binding="{Binding Job}" Width="150" />
                        <DataGridTextColumn Header="Öğe" Binding="{Binding Item}" Width="220" />
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="LogEmpty" Text="Bu dönemde kayıt yok." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>
