<ui:FluentWindow x:Class="Backup360.UI.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Backup360" Width="920" Height="600" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#312E81" Offset="0.6" />
                    <GradientStop Color="#0E7490" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="190" Height="190" HorizontalAlignment="Center">
                        <Ellipse x:Name="Orbit" StrokeThickness="3" StrokeDashArray="26 60" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#99FFFFFF" />
                            </Ellipse.Stroke>
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Image Source="pack://application:,,,/Backup360;component/Assets/logo.png" Width="124" Height="124" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <TextBlock Text="Backup360" Foreground="White" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,2" />
                    <TextBlock Text="Yedekle · Zamanla · Buluta gönder" Foreground="#CBD5E1" FontSize="14" HorizontalAlignment="Center" />
                    <StackPanel Margin="0,26,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <ui:SymbolIcon Symbol="Folder24" Foreground="#67E8F9" Margin="0,0,10,0" />
                            <TextBlock Text="Klasör bazlı veya sıkıştırılmış yedek" Foreground="#E2E8F0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <ui:SymbolIcon Symbol="Database24" Foreground="#67E8F9" Margin="0,0,10,0" />
                            <TextBlock Text="SQL Server, MySQL, PostgreSQL, Firebird, SQLite" Foreground="#E2E8F0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <ui:SymbolIcon Symbol="Cloud24" Foreground="#67E8F9" Margin="0,0,10,0" />
                            <TextBlock Text="Google Drive ve diğer bulutlar" Foreground="#E2E8F0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Ömer ÇARNAÇAR" Foreground="#94A3B8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" Margin="64,0">
                <TextBlock x:Name="Heading" Text="Hoş geldiniz" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SubHeading" Text="Devam etmek için giriş yapın." Style="{StaticResource Muted}" Margin="0,4,0,20" />
                <TextBlock Text="Kullanıcı adı" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="UserBox" Icon="{ui:SymbolIcon Person24}" />
                <TextBlock Text="Parola" Style="{StaticResource FieldLabel}" />
                <ui:PasswordBox x:Name="PassBox" Icon="{ui:SymbolIcon Password24}" />
                <TextBlock x:Name="Pass2Label" Text="Parola (tekrar)" Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
                <ui:PasswordBox x:Name="Pass2Box" Icon="{ui:SymbolIcon Password24}" Visibility="Collapsed" />
                <TextBlock x:Name="Message" Foreground="#F87171" TextWrapping="Wrap" MinHeight="22" Margin="0,10,0,4" />
                <ui:Button x:Name="Submit" Content="Giriş yap" Appearance="Primary" HorizontalAlignment="Stretch" Height="46" FontSize="15" IsDefault="True" Click="Submit_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="64,0,24,20">
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:HyperlinkButton x:Name="MailLink" Padding="0,4" Click="Mail_Click" />
                    <ui:Button x:Name="CopyButton" Content="Kopyala" Icon="{ui:SymbolIcon Copy24}" Margin="12,0,0,0" Click="Copy_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ui:TitleBar Grid.ColumnSpan="2" VerticalAlignment="Top" ShowMaximize="False" />
    </Grid>
</ui:FluentWindow>
