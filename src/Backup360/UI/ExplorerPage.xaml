<Page x:Class="Backup360.UI.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="28,12,28,24">
        <TextBlock Text="Bulut Gezgini" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Bağlı hedeflerinizin içeriğini görün, indirin veya sürücü harfi olarak bağlayın." Style="{StaticResource Muted}" Margin="0,2,0,12" />
        <ui:InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,0,10" />

        <ui:Card Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Üst klasör" Margin="0,0,6,0" Click="Up_Click" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Yenile" Margin="0,0,6,0" Click="Refresh_Click" />
                    <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Klasör oluştur" Icon="{ui:SymbolIcon FolderAdd24}" Margin="0,0,8,0" Click="NewFolder_Click" />
                    <ui:Button x:Name="DownloadButton" Content="İndir" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Click="Download_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <ui:Card x:Name="Transfer" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="TransferTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="TransferPercent" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="TransferBar" Height="6" Maximum="100" Margin="0,6,0,6" IsIndeterminate="True" />
                <Grid>
                    <TextBlock x:Name="TransferStats" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    <ui:Button Content="İptal" HorizontalAlignment="Right" Click="CancelDownload_Click" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="4" Margin="0,10,0,0">
            <Grid>
                <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" SelectionMode="Extended" RowHeight="36" MinHeight="300" MaxHeight="430" MouseDoubleClick="Files_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Ad" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding Tint}" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Boyut" Binding="{Binding SizeText}" Width="110" />
                        <DataGridTextColumn Header="Değiştirilme" Binding="{Binding When}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="Empty" Text="Bu klasör boş." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </ui:Card>

        <TextBlock Text="Disk olarak bağla" Style="{StaticResource Section}" />
        <ui:Card Padding="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="Letters" Width="100" Margin="0,0,8,0" />
                    <ui:Button x:Name="MountButton" Content="Seçili hedefi bağla" Icon="{ui:SymbolIcon HardDrive20}" Appearance="Primary" Margin="0,0,8,0" Click="Mount_Click" />
                    <ui:Button x:Name="InstallButton" Content="WinFsp'i indir" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="WinFsp_Click" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="MountHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <ItemsControl x:Name="Mounted" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                <ui:Button Content="Bağlantıyı kes" HorizontalAlignment="Right" Command="{Binding Unmount}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
