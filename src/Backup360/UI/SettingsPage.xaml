<Page x:Class="Backup360.UI.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="24,8,24,16" MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}" />

        <TextBlock Text="Görünüm" Style="{StaticResource Section}" />
        <ui:Card Padding="18">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Tema" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox x:Name="ThemeBox" Width="180" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="Koyu" />
                        <ComboBoxItem Content="Açık" />
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Vurgu rengi" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <StackPanel x:Name="AccentRow" Orientation="Horizontal" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <TextBlock Text="E-posta bildirimleri (SMTP)" Style="{StaticResource Section}" />
        <ui:Card Padding="18">
            <StackPanel>
                <ui:ToggleSwitch x:Name="MailOn" Content="E-posta bildirimlerini aç (hata olduğunda her zaman gönderilir)" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Sunucu" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Host" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Port" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="Port" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Güvenlik" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="Security"><ComboBoxItem Content="Otomatik" /><ComboBoxItem Content="SSL/TLS" /><ComboBoxItem Content="STARTTLS" /><ComboBoxItem Content="Yok" /></ComboBox></StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Kullanıcı" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="SmtpUser" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Parola" Style="{StaticResource FieldLabel}" /><ui:PasswordBox x:Name="SmtpPass" PlaceholderText="Değiştirmek için yazın" /></StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Gönderen" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="From" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Alıcı" Style="{StaticResource FieldLabel}" /><ui:TextBox x:Name="To" PlaceholderText="virgülle birden çok adres" /></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="OnWarn" Content="Uyarılarda da gönder" Margin="0,0,20,0" />
                    <CheckBox x:Name="OnOk" Content="Başarılı işlerde de gönder" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <ui:Button Content="Kaydet" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,8,0" Click="SaveMail_Click" />
                    <ui:Button Content="Test e-postası gönder" Icon="{ui:SymbolIcon Mail24}" Click="TestMail_Click" />
                    <TextBlock x:Name="MailResult" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="460" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <TextBlock Text="Fidye yazılımı koruması" Style="{StaticResource Section}" />
        <ui:Card Padding="18" VerticalContentAlignment="Top">
            <StackPanel>
                <ui:ToggleSwitch x:Name="GuardOn" Content="Kaynaklarda şifrelenme belirtisi görülürse yedeklemeyi durdur ve uyar" />
                <TextBlock Text="Şüpheli uzantı, fidye notu ve içeriği şifrelenmiş görünen dosyaları arar. Şüphe varsa hedefteki sağlam yedeklere dokunulmaz, e-posta ve ekran uyarısı verilir." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Kontrol sıklığı (dakika)" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ui:NumberBox x:Name="GuardMinutes" Minimum="1" Maximum="1440" Width="130" Margin="0,0,10,0" />
                    <ui:Button Content="Kaydet" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,8,0" Click="SaveGuard_Click" />
                    <ui:Button Content="Şimdi tara" Icon="{ui:SymbolIcon ShieldCheckmark24}" Click="ScanGuard_Click" />
                </StackPanel>
                <TextBlock x:Name="GuardResult" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <TextBlock Text="Kullanıcılar" Style="{StaticResource Section}" />
        <ui:Card Padding="18">
            <StackPanel>
                <ListBox x:Name="Users" Height="110" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Parolamı değiştir" Icon="{ui:SymbolIcon Key24}" Margin="0,0,8,0" Click="ChangePassword_Click" />
                    <ui:Button Content="Kullanıcı ekle" Icon="{ui:SymbolIcon PersonAdd24}" Margin="0,0,8,0" Click="AddUser_Click" />
                    <ui:Button Content="Kullanıcıyı sil" Icon="{ui:SymbolIcon Delete24}" Click="DeleteUser_Click" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <TextBlock Text="Taşınabilir veritabanı (SQLite)" Style="{StaticResource Section}" />
        <ui:Card Padding="18">
            <StackPanel>
                <TextBlock x:Name="DbPath" Style="{StaticResource Muted}" />
                <TextBlock Text="Uygulama klasörünü kopyalamanız yeterlidir. Parolalar güvenlik gereği bu Windows hesabına bağlıdır, yeni bilgisayarda yeniden girilir." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Veritabanını dışa aktar" Icon="{ui:SymbolIcon ArrowExportLtr24}" Margin="0,0,8,0" Click="Export_Click" />
                    <ui:Button Content="Veri klasörünü aç" Icon="{ui:SymbolIcon Folder24}" Click="OpenData_Click" />
                </StackPanel>
                <TextBlock x:Name="ToolsText" Style="{StaticResource Muted}" Margin="0,14,0,0" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
