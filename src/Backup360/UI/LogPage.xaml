<Page x:Class="Backup360.UI.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="24,8,24,16">
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Canlı Günlük" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Tüm işlerin kayıtları ve dosya aktarımları anlık olarak akar." Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:ToggleSwitch x:Name="Follow" Content="Canlı izle" IsChecked="True" Margin="0,0,14,0" />
                <ui:Button Content="Günlük klasörü" Icon="{ui:SymbolIcon Folder24}" Click="Open_Click" />
            </StackPanel>
        </Grid>
        <ui:Card Padding="4">
            <TextBox x:Name="Output" IsReadOnly="True" Height="580" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="Transparent" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </ui:Card>
    </StackPanel>
</Page>
