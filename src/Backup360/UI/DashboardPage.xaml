<Page x:Class="Backup360.UI.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Page.Resources>
        <DataTemplate x:Key="TopRow">
            <StackPanel Margin="0,5">
                <Grid>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Height="3" Maximum="100" Value="{Binding Ratio, Mode=OneWay}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <StackPanel Margin="24,8,24,16">
        <Border CornerRadius="8" Height="88" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#4338CA" Offset="0.62" />
                    <GradientStop Color="#06B6D4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Canvas HorizontalAlignment="Right" Width="420">
                    <Ellipse Width="210" Height="210" Fill="#1FFFFFFF" Canvas.Left="150" Canvas.Top="-70">
                        <Ellipse.RenderTransform>
                            <TranslateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-50" To="60" Duration="0:0:7" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="24" Duration="0:0:5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="130" Height="130" Fill="#1AFFFFFF" Canvas.Left="40" Canvas.Top="20">
                        <Ellipse.RenderTransform>
                            <TranslateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="40" To="-40" Duration="0:0:9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Canvas>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0">
                    <Grid Width="48" Height="48" Margin="0,0,16,0">
                        <Ellipse Fill="#33FFFFFF" />
                        <ui:SymbolIcon x:Name="HeroIcon" Symbol="ShieldCheckmark24" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" Text="Hoş geldiniz" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="HeroSub" Foreground="#E2E8F0" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Columns="4" Margin="0,12,0,0">
            <ui:Card Margin="0,0,6,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Briefcase24" FontSize="30" Foreground="#10B981" Margin="0,0,14,0" />
                    <StackPanel><TextBlock Text="Etkin işler" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="StatOk" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Cloud24" FontSize="30" Foreground="#F59E0B" Margin="0,0,14,0" />
                    <StackPanel><TextBlock Text="Hedefler" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="StatBad" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="30" Foreground="#818CF8" Margin="0,0,14,0" />
                    <StackPanel><TextBlock Text="Aktarılan (7 gün)" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="StatSent" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="TopSpeed24" FontSize="30" Foreground="#22D3EE" Margin="0,0,14,0" />
                    <StackPanel><TextBlock Text="Ortalama hız" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="StatSpeed" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <TextBlock x:Name="LiveTitle" Text="Canlı aktarımlar" Style="{StaticResource Section}" Visibility="Collapsed" Margin="0,14,0,8" />
        <StackPanel x:Name="LivePanel" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Geçerli iş durumu" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl x:Name="StatusList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding Brush}" FontSize="20" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ChartTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox x:Name="MetricBox" Width="170" Margin="0,0,8,0" SelectionChanged="Chart_Changed">
                                <ComboBoxItem Content="Aktarılan veri" IsSelected="True" />
                                <ComboBoxItem Content="Çalışma sayısı" />
                            </ComboBox>
                            <ComboBox x:Name="RangeBox" Width="130" SelectionChanged="Chart_Changed">
                                <ComboBoxItem Content="Günlük" IsSelected="True" />
                                <ComboBoxItem Content="Haftalık" />
                                <ComboBoxItem Content="Aylık" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <lvc:CartesianChart x:Name="Chart" Background="Transparent" Height="200" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="En büyük işler" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock x:Name="BiggestEmpty" Text="Henüz veri yok." Style="{StaticResource Muted}" />
                    <ItemsControl x:Name="Biggest" ItemTemplate="{StaticResource TopRow}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="En uzun süren işler" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock x:Name="LongestEmpty" Text="Henüz veri yok." Style="{StaticResource Muted}" />
                    <ItemsControl x:Name="Longest" ItemTemplate="{StaticResource TopRow}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="4" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Son etkinlikler" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock x:Name="FeedEmpty" Text="Henüz çalışma yok." Style="{StaticResource Muted}" />
                    <ItemsControl x:Name="Feed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding Brush}" FontSize="22" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Label}" FontSize="12" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="6" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Yaklaşan zamanlamalar" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock x:Name="UpcomingEmpty" Text="Zamanlanmış iş yok." Style="{StaticResource Muted}" />
                    <ItemsControl x:Name="Upcoming">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:ProgressRing IsIndeterminate="False" Progress="{Binding Percent}" Width="28" Height="28" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Remaining}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </Grid>

    </StackPanel>
</Page>
