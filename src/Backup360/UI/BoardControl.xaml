<UserControl x:Class="Backup360.UI.BoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ActionTemplate">
            <ui:Button Command="{Binding Command}" ToolTip="{Binding Label}" Margin="0,0,6,0" Padding="9,6">
                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" />
            </ui:Button>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Style="{StaticResource HoverFrame}" Width="392" Margin="0,0,12,12">
            <ui:Card Padding="16" VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="44" Height="44" Margin="0,0,12,0">
                        <Ellipse Fill="{Binding Accent}" Opacity="0.18" />
                        <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding Accent}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IconVisibility}" />
                        <Image Source="{Binding Logo}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LogoVisibility}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource Muted}" ToolTip="{Binding Subtitle}" />
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="11" Padding="9,3" Margin="8,0,0,0" Background="#1A94A3B8" Cursor="{Binding StatusCursor}" ToolTip="{Binding StatusTip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding StatusCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Chips}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,6" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Footer}" FontSize="12" Style="{StaticResource Muted}" MaxWidth="210" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionTemplate}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Visibility="{Binding DaysVisibility}">
                        <StackPanel>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="42" /><ColumnDefinition Width="38" /><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Yedek günü" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Saat" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Adet" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Boyut" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="Durum" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="42" /><ColumnDefinition Width="38" /><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Day}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding Live.Visibility}">
                        <Grid>
                            <TextBlock Text="{Binding Live.Stage}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Live.PercentText}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <ProgressBar Height="6" Margin="0,6,0,6" Maximum="100" Value="{Binding Live.Percent, Mode=OneWay}" IsIndeterminate="{Binding Live.Indeterminate}" />
                        <TextBlock Text="{Binding Live.Item}" FontSize="12" Height="17" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Live.Item}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Kalan süre" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Live.Eta}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Geçen süre" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Live.Elapsed}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Hız" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Live.Speed}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="Boyut" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Live.SizeText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="Dosya" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Live.Files}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="Adım" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Live.StepText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Live.Sending}" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding Live.SendingVisibility}" />
                        <Border Background="#0B0F0C" BorderBrush="#1F3B2A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Height="124">
                            <TextBlock Text="{Binding Live.Flow}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" LineHeight="15" LineStackingStrategy="BlockLineHeight" Foreground="#4ADE80" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ui:Button Command="{Binding Live.Stop}" Visibility="{Binding Live.StopVisibility}" Content="Durdur" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </ui:Card>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="24,8,12,16">
        <Grid Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HintText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel x:Name="TopActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <ui:InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,14,10" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,8" />

        <ItemsControl x:Name="Groups">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,10,0,4">
                        <Grid Margin="0,0,14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border CornerRadius="9" Padding="7,1" Margin="8,0,0,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Command="{Binding Action.Command}" Visibility="{Binding ActionVisibility}" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Action.Icon}" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Action.Label}" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="Empty" HorizontalAlignment="Center" Margin="0,90,0,0" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="56" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="0,12,0,0" FontSize="15" />
        </StackPanel>
    </StackPanel>
</UserControl>
