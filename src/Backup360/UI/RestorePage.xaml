<Page x:Class="Backup360.UI.RestorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="24,8,24,16">
        <TextBlock Text="Geri Yükle" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Yedek önce doğrulanır. Mevcut dosya ve veritabanlarının üzerine yazılmaz: dosyalar yeni klasöre, veritabanları yeni adla açılır." Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap" />
        <ui:InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,0,10" />

        <ui:Card Padding="14" VerticalContentAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Yedekleme işi" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="Jobs" Grid.Column="1" SelectionChanged="Job_Changed" />
                <ui:Button Grid.Column="2" Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}" HorizontalAlignment="Right" Click="Refresh_Click" />
            </Grid>
        </ui:Card>

        <ui:Card Padding="4" Margin="0,10,0,0">
            <Grid>
                <DataGrid x:Name="Points" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" RowHeight="36" MinHeight="220" MaxHeight="300" SelectionChanged="Point_Changed"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" VerticalGridLinesBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding When}" Width="145" />
                        <DataGridTextColumn Header="Öğe" Binding="{Binding Item}" Width="*" />
                        <DataGridTextColumn Header="Biçim" Binding="{Binding Kind}" Width="110" />
                        <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="120" />
                        <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="Empty" Text="Bu iş için geri yükleme noktası bulunamadı." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </ui:Card>

        <ui:Card Padding="16" Margin="0,10,0,0" VerticalContentAlignment="Top">
            <StackPanel>
                <StackPanel x:Name="FileOptions">
                    <TextBlock Text="Geri yükleneceği klasör (içinde yeni bir klasör açılır)" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="Destination" />
                        <ui:Button Grid.Column="1" Content="Seç" Icon="{ui:SymbolIcon Folder24}" Margin="8,0,0,0" Click="Pick_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="DbOptions" Visibility="Collapsed">
                    <TextBlock x:Name="DbLabel" Text="Yeni veritabanı adı" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ui:TextBox x:Name="NewName" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="RestoreButton" Content="Geri yükle" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Primary" Margin="0,0,8,0" Click="Restore_Click" />
                    <ui:Button x:Name="CancelButton" Content="İptal" IsEnabled="False" Click="Cancel_Click" />
                </StackPanel>
                <ProgressBar x:Name="Bar" Height="6" Maximum="100" Margin="0,12,0,6" Visibility="Collapsed" />
                <TextBlock x:Name="Log" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
