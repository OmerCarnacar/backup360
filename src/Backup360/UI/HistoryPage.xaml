<Page x:Class="Backup360.UI.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="24,8,24,16">
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Geçmiş" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Çalışmaların süresi, aktarılan veri ve ortalama hızı." Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="Günlük klasörü" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,0" Click="Logs_Click" />
                <ui:Button Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Refresh_Click" />
            </StackPanel>
        </Grid>
        <ui:Card Padding="4">
            <DataGrid x:Name="Grid_" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" VerticalGridLinesBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" CanUserAddRows="False" SelectionMode="Single" RowHeight="38" MinHeight="120">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Başlangıç" Binding="{Binding Started}" Width="150" />
                    <DataGridTextColumn Header="Süre" Binding="{Binding Duration}" Width="90" />
                    <DataGridTextColumn Header="Tür" Binding="{Binding Kind}" Width="70" />
                    <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="170" />
                    <DataGridTemplateColumn Header="Durum" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" Width="85" />
                    <DataGridTextColumn Header="Hız" Binding="{Binding Speed}" Width="95" />
                    <DataGridTextColumn Header="Ayrıntı" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>
    </StackPanel>
</Page>
