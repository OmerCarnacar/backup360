<Page x:Class="Backup360.UI.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="24,8,24,16">
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Yedek Sağlığı" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Hedefe gönderilmiş yedeklerin duruyor ve bozulmamış olduğunu denetler." Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="Kayıpları listeden kaldır" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,0" Click="Forget_Click" />
                <ui:Button Content="Hızlı kontrol" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0" Click="Quick_Click" />
                <ui:Button Content="Tam kontrol" Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Primary" Click="Deep_Click" />
            </StackPanel>
        </Grid>
        <ui:InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,0,10" />
        <StackPanel x:Name="LivePanel" />

        <UniformGrid Columns="4" Margin="0,0,0,12">
            <ui:Card Margin="0,0,6,0" Padding="14,10"><StackPanel><TextBlock Text="Kayıtlı yedek" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="TotalText" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
            <ui:Card Margin="6,0" Padding="14,10"><StackPanel><TextBlock Text="Sağlam" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="OkText" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
            <ui:Card Margin="6,0" Padding="14,10"><StackPanel><TextBlock Text="Bozuk / eksik" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="BadText" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
            <ui:Card Margin="6,0,0,0" Padding="14,10"><StackPanel><TextBlock Text="Son kontrol" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="LastText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></ui:Card>
        </UniformGrid>

        <ui:Card Padding="4">
            <Grid>
                <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" RowHeight="36" MinHeight="150" MaxHeight="300"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" VerticalGridLinesBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Durum" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Status}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="İş" Binding="{Binding Job}" Width="150" />
                        <DataGridTextColumn Header="Hedef" Binding="{Binding Target}" Width="100" />
                        <DataGridTextColumn Header="Dosya" Binding="{Binding File}" Width="*" />
                        <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" Width="85" />
                        <DataGridTextColumn Header="Son kontrol" Binding="{Binding Checked}" Width="135" />
                        <DataGridTextColumn Header="Ayrıntı" Binding="{Binding Detail}" Width="190" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="Empty" Text="Henüz kayıtlı yedek yok. Sıkıştırılmış ve SQL yedekleri burada listelenir." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </ui:Card>

        <TextBlock Text="Otomatik denetim" Style="{StaticResource Section}" />
        <ui:Card Padding="16" VerticalContentAlignment="Top">
            <StackPanel>
                <ContentControl x:Name="ScheduleHost" />
                <CheckBox x:Name="DeepBox" Margin="0,12,0,0">
                    <TextBlock Text="Tam kontrol yap: her öğenin son yedeğini indirip aç (internet kotası ve süre gerektirir)" TextWrapping="Wrap" />
                </CheckBox>
                <ui:Button Content="Kaydet" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,12,0,0" Click="SaveSchedule_Click" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
