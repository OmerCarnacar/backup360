<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Backup360.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Backup360</RootNamespace>
    <AssemblyName>Backup360</AssemblyName>
        <ApplicationIcon>..\..\assets\Backup360.ico</ApplicationIcon>
    <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::Now.ToString('yyyy.MM.dd.HHmm'))</BuildStamp>
    <BuildCode Condition="'$(BuildCode)' == ''">$([System.Guid]::NewGuid().ToString('N').Substring(0,8).ToUpperInvariant())</BuildCode>
    <Version>$(BuildStamp)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Backup360</Product>
    <Company>Ömer ÇARNAÇAR</Company>
    <Authors>Ömer ÇARNAÇAR</Authors>
    <Copyright>Copyright (c) 2026 Ömer ÇARNAÇAR</Copyright>
    <Description>Backup360 - Google Drive yedekleme ve klasör taşıma</Description>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
        <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
    <EmbeddedResource Include="google-client.txt" LogicalName="google-client.txt" Condition="Exists('google-client.txt')" />
    <AssemblyMetadata Include="BuildCode" Value="$(BuildCode)" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.1.0-dev-798" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

</Project>
